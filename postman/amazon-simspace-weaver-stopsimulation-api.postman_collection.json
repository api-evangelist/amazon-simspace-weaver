          "name": "Amazon Stop Simulation",
          "id": "7c4502eb-3acf-44af-99c7-4ee8b92dcd64",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Amz-Content-Sha256",
                "value": "<string>"
              },
              {
                "key": "X-Amz-Date",
                "value": "<string>"
              },
              {
                "key": "X-Amz-Algorithm",
                "value": "<string>"
              },
              {
                "key": "X-Amz-Credential",
                "value": "<string>"
              },
              {
                "key": "X-Amz-Security-Token",
                "value": "<string>"
              },
              {
                "key": "X-Amz-Signature",
                "value": "<string>"
              },
              {
                "key": "X-Amz-SignedHeaders",
                "value": "<string>"
              },
              {
